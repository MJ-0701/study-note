{
  "name": "@study-note/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "prisma": {
    "schema": "../../packages/persistence/prisma/schema.prisma"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --schema ../../packages/persistence/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../../packages/persistence/prisma/schema.prisma",
    "prisma:seed:subjects": "node ../../packages/persistence/prisma/seed-subjects.mjs",
    "prisma:seed": "node ../../packages/persistence/prisma/seed.mjs"
  },
  "dependencies": {
    "@study-note/corpus": "workspace:*",
    "@study-note/domain": "workspace:*",
    "@study-note/persona-engine": "workspace:*",
    "@study-note/auth": "workspace:*",
    "@study-note/persistence": "workspace:*",
    "@study-note/storage": "workspace:*",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "^2.17.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.14.0"
  }
}
