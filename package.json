{
  "name": "study-note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@11.0.9",
  "prisma": {
    "schema": "packages/persistence/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "pnpm --filter @study-note/web dev",
    "dev:backend": "pnpm --filter @study-note/api prisma:migrate:deploy && pnpm --filter @study-note/api prisma:seed && pnpm --filter @study-note/api build && node --env-file-if-exists=.env apps/api/dist/main.js",
    "build": "pnpm --filter @study-note/web build && pnpm --filter @study-note/api build",
    "build:frontend": "pnpm --filter @study-note/web build",
    "build:backend": "pnpm --filter @study-note/api build",
    "prisma:generate": "pnpm --filter @study-note/api prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @study-note/api prisma:migrate:deploy",
    "prisma:seed": "pnpm --filter @study-note/api prisma:seed",
    "test:domain-pdf-workspace": "node --experimental-strip-types --no-warnings --test packages/domain/__tests__/pdf-workspace.spec.ts",
    "test:web-gate": "node --experimental-strip-types --no-warnings --test apps/web/src/persona-turn/components/gate-state.spec.ts",
    "test:web-onboarding-copy": "node --experimental-strip-types --no-warnings --test apps/web/src/onboarding/secret-handling-copy.spec.ts",
    "test:web-recent-conversations": "node --experimental-strip-types --no-warnings --test apps/web/src/persona-turn/components/recent-conversations.spec.ts",
    "test:web-conversation-route": "node --experimental-strip-types --no-warnings --test apps/web/src/persona-turn/conversation-route.spec.ts",
    "smoke:backend": "pnpm --filter @study-note/api build && node scripts/smoke-backend-contract.mjs",
    "smoke:conversation-list": "pnpm --filter @study-note/api build && node scripts/smoke-conversation-list.mjs",
    "smoke:persona-design": "pnpm --filter @study-note/api build && node scripts/smoke-persona-design.mjs",
    "smoke:auth-signin": "pnpm --filter @study-note/api build && node scripts/smoke-auth-signin.mjs",
    "smoke:auth-signup": "pnpm --filter @study-note/api build && node scripts/smoke-auth-signup.mjs",
    "smoke:auth-deny": "pnpm --filter @study-note/api build && node scripts/smoke-auth-deny.mjs",
    "smoke:auth-session-cookie": "pnpm --filter @study-note/api build && node scripts/smoke-auth-session-cookie.mjs",
    "smoke:auth-dev-disable": "pnpm --filter @study-note/api build && node scripts/smoke-auth-dev-disable.mjs",
    "smoke:auth-pii-redaction": "pnpm --filter @study-note/api build && node scripts/smoke-auth-pii-redaction.mjs",
    "smoke:cli-path": "pnpm --filter @study-note/cli build && node scripts/smoke-cli-path.mjs",
    "smoke:s3-storage": "pnpm --filter @study-note/storage build && pnpm --filter @study-note/api build && node scripts/smoke-s3-storage.mjs",
    "smoke:s3-real": "pnpm --filter @study-note/api build && node scripts/smoke-real-s3-storage.mjs",
    "smoke:pdf-workspace": "pnpm --filter @study-note/api build && node scripts/smoke-pdf-workspace.mjs",
    "ingest:pdf": "pnpm --filter @study-note/cli build && node --env-file-if-exists=.env apps/cli/dist/ingest-pdf.js",
    "smoke:corpus-ingest": "pnpm --filter @study-note/api build && node scripts/smoke-corpus-ingest.mjs",
    "persona:turn": "pnpm --filter @study-note/cli build && node --env-file-if-exists=.env apps/cli/dist/persona-turn.js",
    "smoke:persona-turn": "pnpm --filter @study-note/api build && node scripts/smoke-persona-turn.mjs",
    "evidence:real-fixture": "pnpm --filter @study-note/api build && pnpm --filter @study-note/cli build && node scripts/ac13-fixture-evidence.mjs",
    "evidence:real-pdf": "pnpm --filter @study-note/api build && pnpm --filter @study-note/cli build && node scripts/ac13-real-pdf-evidence.mjs",
    "evidence:real-agent": "pnpm --filter @study-note/api build && pnpm --filter @study-note/cli build && STUDY_NOTE_LLM_AGENT=gemini-cli node scripts/ac13-real-pdf-evidence.mjs",
    "db:up-persistent": "node scripts/db-persistent.mjs up",
    "db:down-persistent": "node scripts/db-persistent.mjs down",
    "mcp:server": "pnpm --filter @study-note/mcp build && node --env-file-if-exists=.env apps/mcp/dist/index.js",
    "smoke:mcp-tool-list": "pnpm --filter @study-note/corpus build && pnpm --filter @study-note/mcp build && node scripts/smoke-mcp-tool-list.mjs",
    "smoke:mcp-fail-closed": "pnpm --filter @study-note/corpus build && pnpm --filter @study-note/mcp build && node scripts/smoke-mcp-fail-closed.mjs",
    "smoke:mcp-env-validate": "pnpm --filter @study-note/corpus build && pnpm --filter @study-note/mcp build && node scripts/smoke-mcp-env-validate.mjs",
    "smoke:mcp-persona-prompt": "pnpm --filter @study-note/corpus build && pnpm --filter @study-note/mcp build && node scripts/smoke-mcp-persona-prompt.mjs",
    "smoke:mcp-onboarding": "pnpm --filter @study-note/corpus build && pnpm --filter @study-note/mcp build && node scripts/smoke-mcp-onboarding.mjs",
    "smoke:admin-audit-log": "pnpm --filter @study-note/api build && node scripts/smoke-admin-audit-log.mjs",
    "smoke:admin-cannot-modify-master": "pnpm --filter @study-note/api build && node scripts/smoke-admin-cannot-modify-master.mjs",
    "smoke:admin-users-list": "pnpm --filter @study-note/api build && node scripts/smoke-admin-users-list.mjs",
    "smoke:admin-role-promote": "pnpm --filter @study-note/api build && node scripts/smoke-admin-role-promote.mjs",
    "smoke:admin-reject": "pnpm --filter @study-note/api build && node scripts/smoke-admin-reject.mjs",
    "smoke:admin-review": "pnpm --filter @study-note/api build && node scripts/smoke-admin-review.mjs",
    "smoke:normal-access": "pnpm --filter @study-note/api build && node scripts/smoke-normal-access.mjs",
    "test:backend": "pnpm --filter @study-note/api build && node scripts/run-backend-tests.mjs",
    "preview": "pnpm --filter @study-note/web preview"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@study-note/domain": "workspace:*",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/client": "^6.19.3",
    "@xenova/transformers": "^2.17.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dompurify": "^3.4.2",
    "marked": "^18.0.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.14.0"
  }
}
