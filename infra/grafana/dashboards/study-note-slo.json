{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "schemaVersion": 39,
  "version": 1,
  "uid": "study-note-slo",
  "title": "study-note SLO (Availability / Latency / Sync)",
  "tags": ["study-note", "slo", "prometheus"],
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "refresh": "1m",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "안내",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "SLI = Prom HTTP + sync 메트릭. SLO 정의 + burn rate alert = Datadog SLO UI (`docs/observability/slos.md` SoT). 본 패널은 그래프 가시화만. baseline = 7d rolling, alert 활성은 7d 누적 후."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API availability (7d) — SLO 99.5%",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 3 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(study_note_http_requests_total{status=~\"2..|3..\",route!~\"/api/health.*|/api/metrics\"}[7d])) / sum(rate(study_note_http_requests_total{route!~\"/api/health.*|/api/metrics\"}[7d]))",
          "legendFormat": "availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency (5m) — SLO < 800ms",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 3 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(study_note_http_request_duration_seconds_bucket{route!~\"/api/health.*|/api/metrics\"}[5m])))",
          "legendFormat": "p95 (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "sync success rate (7d) — SLO 99.0%",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 3 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(study_note_sync_put_total{outcome=\"success\"}[7d])) / sum(rate(study_note_sync_put_total[7d]))",
          "legendFormat": "sync_success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.98 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "availability trend (1h rolling)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(study_note_http_requests_total{status=~\"2..|3..\",route!~\"/api/health.*|/api/metrics\"}[1h])) / sum(rate(study_note_http_requests_total{route!~\"/api/health.*|/api/metrics\"}[1h]))",
          "legendFormat": "availability (1h)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 latency trend",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(study_note_http_request_duration_seconds_bucket{route!~\"/api/health.*|/api/metrics\"}[5m])))",
          "legendFormat": "p95 (s)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "text",
      "title": "Burn rate alerts",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "options": {
        "mode": "markdown",
        "content": "burn rate alert (3 SLO × fast 1h + slow 6h = 6 monitor) = Datadog SLO UI. 정의 = `docs/observability/slos.md`. 7d baseline 누적 후 mute 해제."
      }
    }
  ]
}
