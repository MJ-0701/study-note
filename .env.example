# Local Development Port
PORT=3001

# Database Configuration (for local dev without docker)
# DATABASE_URL="mysql://study_note:study_note@127.0.0.1:3306/study_note"
# Database Configuration (for docker-compose)
DATABASE_URL="mysql://study_note:study_note@db-service:3306/study_note"

SESSION_TOKEN_PEPPER="change-me-local-session-pepper"
PDF_UPLOAD_MAX_BYTES=26214400

# Storage Configuration
# For local file storage: STORAGE_PROVIDER=local
# For docker-compose (localstack):
STORAGE_PROVIDER=s3
S3_BUCKET="study-note-materials"
S3_REGION="ap-northeast-2"
S3_ENDPOINT="http://s3-service:4566"
S3_FORCE_PATH_STYLE=true

STUDY_NOTE_DEV_USER_NAME="채명정"
STUDY_NOTE_DEV_STUDENT_NUMBER="20264514"
STUDY_NOTE_DEV_USER_EMAIL="student@example.com"
STUDY_NOTE_SECOND_USER_NAME="Ownership Reviewer"
STUDY_NOTE_SECOND_STUDENT_NUMBER="20260000"
STUDY_NOTE_SECOND_USER_EMAIL="reviewer@example.com"

# API Base URL for Frontend
# For local dev without docker: VITE_API_BASE_URL="http://127.0.0.1:3001/api"
# For docker-compose:
VITE_API_BASE_URL="http://127.0.0.1:3001/api"
