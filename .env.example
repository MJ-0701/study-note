# Local Development Port — backend listens here.
# 3010 picked to avoid common collisions: 3000 (other FE projects), 3001 (legacy).
PORT=3010

# 데이터베이스 연결 (로컬 직접 실행 시)
# DATABASE_URL="mysql://study_note:study_note@127.0.0.1:3306/study_note"
# 데이터베이스 연결 (docker-compose 환경 — be-service 내부)
DATABASE_URL="mysql://study_note:study_note@db-service:3306/study_note"

# 세션 토큰 서명 키 — 반드시 변경 (prod에서는 AWS Secrets Manager에서 주입)
SESSION_TOKEN_PEPPER="change-me-local-session-pepper"

# PDF 업로드 최대 크기 (bytes). 기본 25MB.
PDF_UPLOAD_MAX_BYTES=26214400

# 운영 프론트 origin 허용 목록 (comma-separated).
# prod 예: CORS_ALLOWED_ORIGINS="https://study-note.910701.xyz"
CORS_ALLOWED_ORIGINS=""

# -----------------------------------------------------------------------
# Optional Datadog Backend APM / Logs (developer/internal)
# -----------------------------------------------------------------------

# 실제 DD_API_KEY 값은 파일에 쓰지 않습니다.
# Azure Container App secret `dd-api-key` 로 저장한 뒤 env 에
# DD_API_KEY=secretref:dd-api-key 형태로 연결합니다.
DD_SERVICE=study-note-api
DD_ENV=development
DD_VERSION=local
DD_SITE=us5.datadoghq.com
DD_TRACE_ENABLED=false
DD_LOGS_ENABLED=false
DD_LOGS_INJECTION=true
DD_SOURCE=nodejs

# -----------------------------------------------------------------------
# S3 Storage Configuration (plan sprint-10 R1/R7)
# -----------------------------------------------------------------------

# 스토리지 프로바이더 선택: local (in-memory mock) | s3 (localstack 또는 AWS)
# docker-compose 기본값: s3
STORAGE_PROVIDER=s3

# S3 버킷 이름
S3_BUCKET="study-note-dev"

# S3 리전 (localstack: us-east-1, prod AWS: 실제 리전 기입)
S3_REGION="us-east-1"

# 서버가 S3에 접근하는 내부 엔드포인트 (docker compose 내부 주소)
# prod AWS 사용 시 이 항목을 주석 처리하면 AWS 기본 엔드포인트 사용
S3_ENDPOINT="http://s3-service:4566"

# 브라우저가 직접 PUT할 공개 엔드포인트 (pre-signed URL의 host에 반영됨)
# prod AWS 사용 시 이 항목을 주석 처리하면 AWS virtual-host 스타일 URL 사용
S3_PUBLIC_ENDPOINT="http://localhost:4566"

# localstack 전용 path-style URL 강제 (prod AWS에서는 false)
S3_FORCE_PATH_STYLE=true

# S3 액세스 키 (localstack dev 전용 더미값 — prod는 IAM 역할 사용, 이 항목 주석 처리)
# 주의: 실제 AWS 액세스 키를 이 파일에 절대 기입하지 말 것 (.env.local에서 관리)
S3_ACCESS_KEY_ID="test"

# S3 시크릿 키 (localstack dev 전용 더미값 — prod는 IAM 역할 사용, 이 항목 주석 처리)
# 주의: 실제 시크릿을 이 파일에 절대 기입하지 말 것. .env.local에 별도 관리
S3_SECRET_ACCESS_KEY="test"

# -----------------------------------------------------------------------
# Dev 사용자 시드 설정 (STUDY_NOTE_RUN_SEED=true 시 seed 실행)
# -----------------------------------------------------------------------
STUDY_NOTE_DEV_USER_NAME="Dev User"
STUDY_NOTE_DEV_STUDENT_NUMBER="20260001"
STUDY_NOTE_DEV_USER_EMAIL="dev1@example.com"
STUDY_NOTE_SECOND_USER_NAME="Reviewer"
STUDY_NOTE_SECOND_STUDENT_NUMBER="20260002"
STUDY_NOTE_SECOND_USER_EMAIL="reviewer@example.com"

# 과목 기준 데이터 seed 실행 여부. dev user를 만들지 않으므로 prod에서도 안전합니다.
STUDY_NOTE_RUN_SUBJECT_SEED=true

# dev 사용자 seed 실행 여부 (dev=true, prod=false 기본)
STUDY_NOTE_RUN_SEED=true

# -----------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------

# API Base URL for Frontend (host에서 접근하는 주소)
# docker-compose: http://127.0.0.1:3010/api
# local dev (no docker): http://127.0.0.1:PORT/api
# prod API: https://study-note.api.910701.xyz/api
VITE_API_BASE_URL="http://127.0.0.1:3010/api"

# admin SPA 의 '운영 지표' 탭은 Grafana 만 공개 안내한다.
# 미설정 시 production Grafana dashboard URL fallback 을 사용한다.
# 예: VITE_GRAFANA_URL="https://grafana.910701.xyz/d/study-note-ops"
# VITE_GRAFANA_URL=""
# VITE_GRAFANA_LABEL="Grafana 운영 대시보드"
